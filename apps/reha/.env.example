# Kopieren nach .env.local (lokal) bzw. als Secrets auf dem Server setzen.
# NIEMALS eine .env mit echten Werten committen (.gitignore).

# Verbindung der Anwendung – eingeschränkte Rolle ohne UPDATE/DELETE auf
# Dokumentationstabellen (ADR 0002). Lokal legt `pnpm db:local` beide Rollen an.
DATABASE_URL=postgres://reha_app:reha_app@127.0.0.1:5433/reha

# Verbindung für Migrationen – Owner-Rolle, nur für `pnpm db:migrate`.
DATABASE_URL_OWNER=postgres://reha_owner:reha_owner@127.0.0.1:5433/reha

# better-auth: mindestens 32 zufällige Zeichen, z. B. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
BETTER_AUTH_URL=http://localhost:3000

# Schmerzampel: on = automatische Einfärbung (ADR 0011), off = nur Wert + Legende (Rückfall ADR 0007)
PAIN_TRAFFIC_LIGHT=on

# Ablage für hochgeladene Bilder des Wissensbereichs (ADR 0009)
UPLOAD_DIR=./data/uploads

NEXT_TELEMETRY_DISABLED=1
